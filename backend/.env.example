# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Models (Verified against official Google GenAI docs)
# Thinking level for gemini-3.8-flash: lowest supported level for fast latency
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Default embedding model: gemini-embedding-2 (task instruction in text).
# If switching to gemini-embedding-001, task_type will be auto-set.
GEMINI_EMBED_MODEL=gemini-embedding-2
# Text-to-speech model: gemini-3.8-flash-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Application Settings
APP_NAME=KSRCE Handbook Assistant
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Storage & Retrieval Settings
DATA_DIR=../Data
STORAGE_DIR=./storage
RERANK_MODE=gemini
ENABLE_LONG_CONTEXT_FALLBACK=true
MAX_CONTEXT_TOKENS=8000
RATE_LIMIT_PER_MINUTE=60

# Admin Authentication
ADMIN_KEY=dev-ksrce-admin-secret-key
